#### 2. `azure_rag.py` (Modified RAG Pipeline)
```python
import os
import json
import re
from qwen2_5 import Qwen2_5
from langchain_community.vectorstores import FAISS
from langchain_community.embeddings import HuggingFaceEmbeddings
from langchain.chains import RetrievalQA
from langchain.prompts import PromptTemplate

# ===== CONFIG =====
DATASET_PATH = "azure_function_patterns.json"
CONVENTIONS_PATH = "conventions.json"
EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
QWEN_API_KEY = os.getenv("QWEN_API_KEY")

# ===== LOADING =====
def load_conventions():
    """Load team-specific conventions"""
    with open(CONVENTIONS_PATH, "r") as f:
        return json.load(f)

def load_dataset():
    """Load Azure Function patterns"""
    with open(DATASET_PATH, "r") as f:
        return json.load(f)

# ===== VECTOR DB =====
def create_vector_db(patterns):
    """Create FAISS vector store"""
    embeddings = HuggingFaceEmbeddings(model_name=EMBEDDING_MODEL)
    texts = [f"{p['pattern']} - {p['description']}" for p in patterns]
    return FAISS.from_texts(texts, embeddings)

# ===== PROMPT ENGINEERING =====
PROMPT_TEMPLATE = """
You are an Azure Functions expert. Generate C# code matching these team conventions:
- Folder structure: {folder_structure}
- Class name: {class_name}
- Method name: {method_name}
- Namespace: {namespace}
- Validation: {validation}
- Logging: {logging}
- Dependencies: {dependencies}

Generate code for: "{query}"

Rules:
1. Use async/await for all operations
2. Always validate inputs with {validation}
3. Include {logging} with structured logs
4. Return HTTP 400 for invalid inputs
5. Do NOT add any comments

Context from knowledge base:
{context}
"""

def setup_rag(conventions, patterns):
    """Initialize RAG with team conventions"""
    vector_db = create_vector_db(patterns)
    
    # Add conventions to prompt
    prompt = PromptTemplate(
        template=PROMPT_TEMPLATE,
        input_variables=["query", "context", "folder_structure", 
                         "class_name", "method_name", "namespace",
                         "validation", "logging", "dependencies"]
    )
    
    llm = Qwen2_5(
        model="qwen2.5-72b",
        api_key=QWEN_API_KEY,
        temperature=0.2
    )
    
    return RetrievalQA.from_chain_type(
        llm=llm,
        retriever=vector_db.as_retriever(),
        return_source_documents=True,
        chain_type_kwargs={"prompt": prompt}
    )

# ===== VALIDATION =====
def validate_conventions(code, conventions):
    """Check if output matches team conventions"""
    # Check folder structure
    if conventions["folder_structure"] not in code:
        return False, f"Missing folder structure: {conventions['folder_structure']}"
    
    # Check method name
    if not re.search(r"public async Task.*" + conventions["method_name"], code):
        return False, f"Invalid method name: {conventions['method_name']}"
    
    # Check namespace
    if not re.search(r"namespace\s+" + conventions["namespace"], code):
        return False, f"Invalid namespace: {conventions['namespace']}"
    
    # Check dependencies
    for dep in conventions["dependencies"]:
        if dep not in code:
            return False, f"Missing dependency: {dep}"
    
    return True, "All conventions met"

# ===== GENERATION =====
def generate_code(query, conventions, rag_chain=None):
    if not rag_chain:
        conventions_data = load_conventions()
        patterns = load_dataset()
        rag_chain = setup_rag(conventions_data, patterns)
    
    # Inject conventions into query
    formatted_conventions = {
        "folder_structure": conventions["folder_structure"],
        "class_name": conventions["class_name"],
        "method_name": conventions["method_name"],
        "namespace": conventions["namespace"],
        "validation": conventions["validation"],
        "logging": conventions["logging"],
        "dependencies": ", ".join(conventions["dependencies"])
    }
    
    result = rag_chain.invoke({
        "query": query,
        "conventions": formatted_conventions
    })
    
    # Validate output
    valid, message = validate_conventions(result["result"], conventions)
    if not valid:
        return {"error": message, "code": None}
    
    # Extract clean code
    return {"code": result["result"], "valid": valid}

# ===== USAGE EXAMPLE =====
if __name__ == "__main__":
    # Load conventions (using orders team)
    conventions = load_conventions()["orders"]
    
    # Generate code
    result = generate_code(
        "HTTP trigger for /api/v1/orders/{id}",
        conventions
    )
    
    # Output
    if result["valid"]:
        print("="*70)
        print("✅ Generated code matches team conventions:")
        print("="*70)
        print(result["code"])
    else:
        print("="*70)
        print("❌ Validation failed:", result["error"])
        print("="*70)
```

