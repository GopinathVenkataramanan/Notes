🛠️ How to Implement This in Your Pipeline
1. Modify Dataset Loading

def load_dataset():
    patterns = json.load(open("azure_function_patterns.json"))
    
    # Add conventions to every pattern
    for p in patterns:
        if "conventions" not in p:
            p["conventions"] = {
                "folder_structure": "src/Functions/Default",
                "class_name": "Function1",
                "method_name": "Run",
                "namespace": "MyCompany.Functions"
            }
    return patterns
2. Update RAG Prompt with Conventions

# When initializing the chain
rag_chain = RetrievalQA.from_chain_type(
    llm=Qwen2_5(...),
    retriever=vector_db.as_retriever(),
    return_source_documents=True,
    chain_type_kwargs={
        "prompt": PromptTemplate(
            template=PROMPT_TEMPLATE,
            input_variables=["query", "context", "conventions"]
        )
    }
)
3. Pass Conventions in Query

# When generating code
conventions = {
    "folder_structure": "src/MyCompany/Functions/Orders",
    "class_name": "OrdersFunction",
    "method_name": "ProcessOrderAsync"
}

result = rag_chain.invoke({
    "query": "HTTP trigger for /api/v1/orders/{id}",
    "conventions": conventions
})
