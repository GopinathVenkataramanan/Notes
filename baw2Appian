# ⚙️ Step 2: Structural Parsing (Rule-Based)

### Example: Extract process model info

```python
import zipfile, xmltodict, json

def parse_baw_twx(file_path):
    models = []
    with zipfile.ZipFile(file_path, 'r') as z:
        for f in z.namelist():
            if f.endswith('.bpd') or f.endswith('.processapp') or f.endswith('.xml'):
                content = z.read(f).decode('utf-8', errors='ignore')
                try:
                    xml_data = xmltodict.parse(content)
                    models.append({ "file": f, "data": xml_data })
                except Exception as e:
                    print(f"Failed to parse {f}: {e}")
    return models
```

Then, flatten or extract useful nodes:

```python
def extract_process_metadata(model):
    data = model['data']
    process_name = data.get('process', {}).get('@name', '')
    tasks = []
    for node in data.get('process', {}).get('nodes', {}).get('node', []):
        tasks.append({
            "id": node.get('@id'),
            "type": node.get('@type'),
            "name": node.get('@name')
        })
    return { "processName": process_name, "tasks": tasks }
```

This gives a **machine-readable structure**, e.g.:

```json
{
  "processName": "Onboarding",
  "tasks": [
    { "id": "n1", "type": "UserTask", "name": "Collect Info" },
    { "id": "n2", "type": "ScriptTask", "name": "Update CRM" }
  ]
}
```

